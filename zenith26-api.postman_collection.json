{
  "info": {
    "_postman_id": "a9c7b6d1-4e8f-4a3b-9c2d-8e7f6a5b4c3d",
    "name": "Zenith '26 Fest System API",
    "description": "Comprehensive Postman test collection for Zenith '26 College Fest Management System (PM2-01 & PM2-02). Tests all endpoints, live calculation of available seats, server-side validation, error status codes (200, 201, 400, 404, 409), and admin capabilities.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Events",
      "item": [
        {
          "name": "GET /api/events - List All Events",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"]
            },
            "description": "Returns list of all events with live available_seats computed from capacity minus registrations."
          },
          "response": []
        },
        {
          "name": "GET /api/events - Filter by Category & Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events?category=Technical&search=code",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events"],
              "query": [
                {
                  "key": "category",
                  "value": "Technical",
                  "description": "Category filter"
                },
                {
                  "key": "search",
                  "value": "code",
                  "description": "Title search keyword"
                }
              ]
            },
            "description": "Filter events by category ('Technical') and title query ('code')."
          },
          "response": []
        },
        {
          "name": "GET /api/events/1 - Get Event by ID (Success)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1"]
            },
            "description": "Returns details for event ID 1 (Code Sprint 2.0)."
          },
          "response": []
        },
        {
          "name": "GET /api/events/999 - Event Not Found (404 Error)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/events/999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "999"]
            },
            "description": "Tests 404 response when querying a non-existent event ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. Registrations",
      "item": [
        {
