          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"Priya Sharma\",\n  \"roll_number\": \"CS2026-101\",\n  \"email\": \"priya.sharma@college.edu\",\n  \"phone\": \"+91 9876543210\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            },
            "description": "Registers a student for event 1. Expected status: 201 Created."
          },
          "response": []
        },
        {
          "name": "POST /api/events/1/register - [400 Error] Missing Required Field (Name)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"\",\n  \"roll_number\": \"CS2026-101\",\n  \"email\": \"test@college.edu\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            },
            "description": "Deliberately leaves student_name empty to verify server-side validation. Expected status: 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "POST /api/events/1/register - [400 Error] Invalid Email Format (Missing @)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"Rahul Verma\",\n  \"roll_number\": \"ME2026-055\",\n  \"email\": \"invalid-email-address\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            },
            "description": "Tests server-side email verification. Expected status: 400 Bad Request."
          },
          "response": []
        },
        {
          "name": "POST /api/events/1/register - [409 Error] Duplicate Email Registration",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"student_name\": \"Priya Sharma\",\n  \"roll_number\": \"CS2026-101\",\n  \"email\": \"priya.sharma@college.edu\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/events/1/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "events", "1", "register"]
            },
            "description": "Attempts registering the same email for event 1 twice. Expected status: 409 Conflict."
          },
          "response": []
        },
        {
          "name": "GET /api/registrations - List All Registrations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registrations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations"]
            },
            "description": "Lists all student registrations with event titles."
          },
          "response": []
        },
        {
          "name": "GET /api/registrations - Filter by Event ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/registrations?event_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "registrations"],
              "query": [
                {
                  "key": "event_id",
                  "value": "1",
                  "description": "Event ID filter"
                }
              ]
            },
            "description": "Filters registrations to only event 1."
          },
          "response": []
        }
      ]
    },
